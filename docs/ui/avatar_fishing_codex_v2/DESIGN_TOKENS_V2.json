{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "2.0",
  "status": "visual guidance; adapt to actual Python GUI toolkit",
  "referenceViewportPx": { "width": 1536, "height": 1024 },
  "colors": {
    "background": "#EFF6FF",
    "surface": "#FFFFFF",
    "surfaceAlt": "#F7FAFF",
    "surfaceBlue": "#EAF3FF",
    "surfaceBlueStrong": "#DDEBFF",
    "border": "#D6E4FA",
    "borderFocus": "#135BFA",
    "textPrimary": "#10245C",
    "textSecondary": "#526DA7",
    "textMuted": "#6E81A5",
    "primary": "#135BFA",
    "primaryHover": "#0E4FE0",
    "primaryText": "#FFFFFF",
    "success": "#42AF25",
    "successTint": "#EAF9E6",
    "danger": "#E11D48",
    "dangerTint": "#FFF0F2",
    "warning": "#A96611",
    "warningTint": "#FFF5E7",
    "unknown": "#6E81A5",
    "metricMint": "#EAF8F4",
    "metricGold": "#FFF4E5",
    "metricSky": "#EBF5FF",
    "metricCoral": "#FFF0EF",
    "metricLavender": "#F2F0FF",
    "overlay": "#0A245E75"
  },
  "font": {
    "familyWindows": "Segoe UI",
    "fallback": ["Arial", "sans-serif"],
    "sizesPx": {
      "caption": 11,
      "bodySmall": 12,
      "body": 14,
      "button": 14,
      "cardTitle": 17,
      "headerTitle": 35,
      "timer": 31,
      "metricValue": 22
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "timerMonospaceFallback": ["Consolas", "Cascadia Mono", "monospace"]
  },
  "spacingPx": [0, 4, 8, 12, 16, 20, 24, 32],
  "radiiPx": { "input": 8, "button": 9, "tile": 10, "card": 13, "modal": 18 },
  "sizingPx": {
    "headerHeight": 177,
    "topbarPreferredHeight": 90,
    "bodyOuterPadding": 16,
    "columnGap": 14,
    "cardPadding": 15,
    "cardGap": 12,
    "buttonHeight": 48,
    "buttonCompactHeight": 40,
    "inputHeight": 40,
    "tabHeight": 48,
    "checkboxVisual": 22,
    "checkboxHitAreaMin": 32,
    "tableHeaderHeight": 40,
    "tableRowMinHeight": 42,
    "fishIcon": 32,
    "metricTileMinHeight": 80,
    "modalPreferredWidth": 610,
    "modalOuterPadding": 24,
    "modalHeaderHeight": 60,
    "logViewportPreferredHeight": 260,
    "focusRingWidth": 2
  },
  "bodyColumns": {
    "wide": [35, 40, 25],
    "ratioAppliesTo": "usable main content width after margins and column gaps",
    "minWideRecommendedPx": 1400,
    "adaptiveStrategy": "On narrow windows, stack third column below first two; retain no-inner-scroll fish tables and reachable main controls"
  },
  "breakpointsPx": { "wide": 1400, "medium": 1200, "compact": 1024 },
  "tablePolicy": {
    "customFish": "grow-to-all-rows-no-internal-scroll",
    "progress": "grow-to-all-rows-no-internal-scroll",
    "activityLog": "internal-vertical-scroll-allowed"
  },
  "assetsPolicy": {
    "liveWidgetsOverRasterControls": true,
    "preferFishIconsDirectory": "assets/fish-icons-clean",
    "fallback": "generic fish symbol or no icon if crops are damaged/mismatched"
  }
}
